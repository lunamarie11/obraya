# ================================
# ObraYa Backend - Variables de entorno
# Copiar a .env y completar valores
# ================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3002
BACKEND_URL=http://localhost:3000
# Origenes CORS adicionales en produccion, separados por coma (ver ADR-007)
ALLOWED_ORIGINS=
LOG_LEVEL=info

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=obraya
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_URL=postgresql://user:password@localhost:5432/obraya

# Cache
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars-change-in-prod
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-secret-here-also-min-32-chars
JWT_REFRESH_EXPIRATION=30d
ENABLE_DEMO=true
DEMO_SECRET=

# Storage - MinIO (local dev) / S3 (produccion)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=obraya-dev
# En produccion usar AWS:
# AWS_S3_BUCKET=obraya-bucket
# AWS_S3_REGION=sa-east-1
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret

# Payment - Mercado Pago (Checkout Pro, ver ADR-007)
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-token

# Notifications - Firebase Admin SDK, JSON completo del service account (ver ADR-007)
FIREBASE_SERVICE_ACCOUNT=

# Email transaccional - AWS SES (ver ADR-011). Reutiliza AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY de S3 si ya estan seteados. Si falta alguna de estas
# 4 variables, el envio de email queda deshabilitado (best-effort).
AWS_SES_REGION=sa-east-1
EMAIL_FROM=no-reply@obraya.com.ar

# Busqueda - Elasticsearch (ver ADR-007). Si no esta disponible, cae a busqueda ILIKE en Postgres.
ELASTICSEARCH_NODE=http://localhost:9200

# AFIP (Argentina fiscal, ver ADR-010). En AFIP_ENV=testing sin cert/key,
# usa el CUIT publico de homologacion de AFIP (20409378472) y funciona
# out-of-the-box contra los servidores reales de testing de AFIP.
# En produccion, AFIP_CUIT/AFIP_CERT_PATH/AFIP_KEY_PATH son obligatorios;
# si faltan, el modulo AFIP queda deshabilitado (no bloquea al resto de la app).
AFIP_CUIT=20409378472
AFIP_CERT_PATH=/certs/afip.crt
AFIP_KEY_PATH=/certs/afip.key
AFIP_ENV=testing
AFIP_PTO_VTA=1

# Observabilidad - Sentry (ver ADR-013). Si falta SENTRY_DSN, el reporte de
# errores queda deshabilitado (best-effort) y los errores solo quedan en los
# logs de Winston (logs/error.log).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
