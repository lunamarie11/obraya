# Database
DATABASE_URL=postgresql://user:password@localhost:5432/obraya

# Cache
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars

# Payment
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-token

# Storage
AWS_S3_BUCKET=obraya-bucket
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# Notifications
FIREBASE_PROJECT_ID=obraya-firebase-project
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# AFIP (Argentina fiscal)
AFIP_CERT_PATH=/certs/afip.crt
AFIP_KEY_PATH=/certs/afip.key

# Server
PORT=3000
NODE_ENV=development
