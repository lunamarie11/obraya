# ================================
# ObraYa Backend - Variables de entorno
# Copiar a .env y completar valores
# ================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3002
BACKEND_URL=http://localhost:3000
# Origenes CORS adicionales en produccion, separados por coma (ver ADR-007)
ALLOWED_ORIGINS=
LOG_LEVEL=info

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=obraya
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_URL=postgresql://user:password@localhost:5432/obraya

# Cache
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars-change-in-prod
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-secret-here-also-min-32-chars
JWT_REFRESH_EXPIRATION=30d
ENABLE_DEMO=true
DEMO_SECRET=

# Storage - MinIO (local dev) / S3 (produccion, ver ADR-015)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=obraya-dev
# En produccion: si AWS_S3_BUCKET y AWS_S3_REGION estan seteados,
# StorageService usa S3 real en vez de MinIO (variables de arriba se
# ignoran). No hace falta AWS_ACCESS_KEY_ID/SECRET aca: en ECS Fargate las
# credenciales las provee el IAM role de la task.
# AWS_S3_BUCKET=obraya-bucket
# AWS_S3_REGION=sa-east-1
# AWS_CLOUDFRONT_DOMAIN=cdn.obraya.com.ar

# Payment - Mercado Pago (Checkout Pro, ver ADR-007)
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-token

# Notifications - Firebase Admin SDK, JSON completo del service account (ver ADR-007)
FIREBASE_SERVICE_ACCOUNT=

# Email transaccional - AWS SES (ver ADR-011). Sin credenciales explicitas:
# usa el provider chain default del SDK (IAM role de la instancia EC2 en
# produccion, que ya tiene ses:SendEmail/SendRawEmail -- ver iam.tf), igual
# que StorageService con S3. Si falta AWS_SES_REGION o EMAIL_FROM, el envio
# de email queda deshabilitado (best-effort).
AWS_SES_REGION=sa-east-1
EMAIL_FROM=no-reply@obraya.com.ar
# Email interno de ObraYa que recibe la notificacion de "nueva empresa
# registrada, pendiente de aprobacion" (ver ADR-025). OJO: obraya.com.ar no
# tiene MX propio (no hay casilla real detras de @obraya.com.ar todavia),
# por eso en produccion se usa una casilla que si existe.
ADMIN_NOTIFICATION_EMAIL=contacto@obraya.com.ar

# Busqueda - Elasticsearch (ver ADR-007). Si no esta disponible, cae a busqueda ILIKE en Postgres.
ELASTICSEARCH_NODE=http://localhost:9200

# AFIP (Argentina fiscal, ver ADR-010). En AFIP_ENV=testing sin cert/key,
# usa el CUIT publico de homologacion de AFIP (20409378472) y funciona
# out-of-the-box contra los servidores reales de testing de AFIP.
# En produccion, AFIP_CUIT/AFIP_CERT_PATH/AFIP_KEY_PATH/AFIP_ACCESS_TOKEN son
# obligatorios; si falta alguno, el modulo AFIP queda deshabilitado (no
# bloquea al resto de la app).
# AFIP_ACCESS_TOKEN: la libreria @afipsdk/afip.js no habla directo con AFIP,
# usa como proxy la nube de AfipSDK (app.afipsdk.com), que exige su propio
# access_token (gratuito, se obtiene registrandose en https://app.afipsdk.com).
# AFIP_ISSUER_IVA_CONDITION: condicion de IVA del CUIT configurado en
# AFIP_CUIT (quien efectivamente factura), NO del fabricante dueno de cada
# pedido -- determina si se emite Factura B (RI) o C (MONOTRIBUTO/EXENTO).
# Default MONOTRIBUTO si no se configura (opcion segura, ver afip.service.ts).
AFIP_CUIT=20409378472
AFIP_CERT_PATH=/certs/afip.crt
AFIP_KEY_PATH=/certs/afip.key
AFIP_ACCESS_TOKEN=
AFIP_ISSUER_IVA_CONDITION=MONOTRIBUTO
AFIP_ENV=testing
AFIP_PTO_VTA=1

# Observabilidad - Sentry (ver ADR-013). Si falta SENTRY_DSN, el reporte de
# errores queda deshabilitado (best-effort) y los errores solo quedan en los
# logs de Winston (logs/error.log).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
