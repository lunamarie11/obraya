# ─── ObraYa Environment Template ───────────────────────────────────────────
# Copiar este archivo como .env y completar todos los valores.
# NUNCA commitear .env con valores reales.

# PostgreSQL
POSTGRES_USER=obraya
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=obraya_db

# Backend
DATABASE_URL=postgresql://obraya:CHANGE_ME@postgres:5432/obraya_db?schema=public
JWT_SECRET=CHANGE_ME_minimum_32_chars_use_openssl_rand_base64_32
FRONTEND_URL=https://app.obraya.com
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://app.obraya.com

# Frontend
NEXT_PUBLIC_API_URL=https://api.obraya.com/api
