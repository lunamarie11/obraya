# ─── ObraYa Environment Template ───────────────────────────────────────────
# Copiar este archivo como .env y completar todos los valores.
# NUNCA commitear .env con valores reales.

# PostgreSQL
POSTGRES_USER=obraya
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=obraya_db

# Backend
DATABASE_URL=postgresql://obraya:CHANGE_ME@postgres:5432/obraya_db?schema=public
JWT_SECRET=CHANGE_ME_minimum_32_chars_use_openssl_rand_base64_32
FRONTEND_URL=https://app.obraya.com
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://app.obraya.com

# MercadoPago
MP_ACCESS_TOKEN=TEST-CHANGE_ME          # Obtener en https://www.mercadopago.com.ar/developers
BACKEND_URL=https://api.obraya.com      # URL pública para el webhook de MP

# Firebase FCM (para push notifications)
# Descargar serviceAccountKey.json desde Firebase Console → Project Settings → Service Accounts
# Luego minificar el JSON y pegarlo como string en FIREBASE_SERVICE_ACCOUNT
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"CHANGE_ME",...}

# Frontend
NEXT_PUBLIC_API_URL=https://api.obraya.com/api
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=CHANGE_ME.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_VAPID_KEY=CHANGE_ME  # Firebase Console → Cloud Messaging → Web Push certificates
