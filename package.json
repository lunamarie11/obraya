{
  "name": "obraya",
  "version": "0.0.1",
  "private": true,
  "description": "ObraYa - Plataforma de ultima milla para materiales de construccion",
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/mobile",
    "packages/shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "dev:mobile": "npm run start --workspace=packages/mobile",
    "build:backend": "npm run build --workspace=packages/backend",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "typecheck:mobile": "npm run typecheck --workspace=packages/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
